        },
        {
          "name": "Create alquiler (User) - POST /api/alquileres/",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/alquileres/", "host": ["{{baseUrl}}"], "path": ["api", "alquileres", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_id\": 1,\n  \"customer_name\": \"Melanie Estevez\",\n  \"total\": 10000,\n   \"status\": \"reservado\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Mongo - fleet_logs",
      "item": [
        {
          "name": "List fleet logs (Auth) - GET /api/fleet-logs/",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/fleet-logs/", "host": ["{{baseUrl}}"], "path": ["api", "fleet-logs", ""] }
          }
        },
        {
          "name": "Create fleet log (Auth) - POST /api/fleet-logs/ (save fleetLogId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let jsonData = {};",
                  "try { jsonData = pm.response.json(); } catch (e) {}",
                  "if (jsonData.id) pm.collectionVariables.set('fleetLogId', jsonData.id);",
                  "pm.test('Se creó fleet log', function () { pm.expect(jsonData.id).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/fleet-logs/", "host": ["{{baseUrl}}"], "path": ["api", "fleet-logs", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_id\": 1,\n  \"action\": \"creado\",\n  \"note\": \"sin novedad\",\n }"
            }
          }
        },
        {
          "name": "Get fleet log by id (Auth) - GET /api/fleet-logs/:id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/fleet-logs/{{fleetLogId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "fleet-logs", "{{fleetLogId}}", ""]
            }
          }
        },
        {
          "name": "Patch fleet log (Auth) - PATCH /api/fleet-logs/:id",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/fleet-logs/{{fleetLogId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "fleet-logs", "{{fleetLogId}}", ""]
            },
            "body": { "mode": "raw", "raw": "{\n  \"is_active\": false\n}" }
          }
        },
        {
          "name": "Delete fleet log (Auth) - DELETE /api/fleet-logs/:id",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/fleet-logs/{{fleetLogId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "fleet-logs", "{{fleetLogId}}", ""]
            }
          }
        }
      ]
    },
